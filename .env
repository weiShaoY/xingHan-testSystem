# 【通用】环境变量

# 运行环境
VITE_APP_ENV=development

# 版本号
VITE_VERSION = 3.0.2

# 端口号，注意环境变量读取出来都是字符串
VITE_PORT = 3006

# 应用部署基础路径
VITE_BASE_URL = /

# 权限模式
VITE_ACCESS_MODE = frontend

# 跨域请求时是否携带 Cookie
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

