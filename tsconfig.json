{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@views/*": ["./src/views/*"],
      "@imgs/*": ["./src/assets/images/*"],
      "@icons/*": ["./src/assets/icons/*"],
      "@utils/*": ["./src/utils/*"],
      "@stores/*": ["./src/store/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@styles/*": ["./src/assets/styles/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "element-plus/global", "vite-plugin-svg-icons-ng/client"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "**/*.js", "src/routers/guards/beforeEach copy.ts"]
}
